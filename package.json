{
  "name": "nestjs-production-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "npm run prisma:generate",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "prisma generate",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:unit": "npm run build",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "pretest:integration": "npm run build",
    "test:integration": "node test/support/run-postgresql-suite.mjs \"test/integration/*.test.mjs\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node test/support/run-postgresql-suite.mjs \"test/e2e/*.test.mjs\"",
    "pretest:process": "npm run build",
    "test:process": "node test/process/run-process-tests.mjs",
    "test:container": "node test/container/run-container-tests.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "testcontainers": "12.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
